IMAGE = "dotfiles-dev:latest"
CONTAINER_HOME = PurePosixPath("/home/dev")

# Mounted read-only, so the container can't tamper with activate.sh or the config
LOCAL_ENV = ".local_env"
CONFIG_FILE = "devc.yaml"

# Applies to all projects, merged with the project's config
GLOBAL_CONFIG_FILE = (
    Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
    / "devc"
    / CONFIG_FILE
)

# Mounted read-only if present, so the container can't rewrite history or plant hooks
GIT_DIR = ".git"

# Namespaces allow several independent containers for the same project
DEFAULT_NAMESPACE = "main"
# Must be valid in container and volume names, also used for persistent mount names
NAMESPACE_PATTERN = re.compile(r"[a-zA-Z0-9][a-zA-Z0-9_.-]*")

# Set on containers and volumes, so projects can be listed
PROJECT_LABEL = "devc.project"
NAMESPACE_LABEL = "devc.namespace"
# Set on microVMs, several of which may run per project and namespace
MICROVM_LABEL = "devc.microvm"

# Set on the host-side podman exec, must match stow_packages/kitty/configs/devc_window.py
PROJECT_ENV = "DEVC_PROJECT"
NAMESPACE_ENV = "DEVC_NAMESPACE"
WORKDIR_ENV = "DEVC_WORKDIR"
KRUN_ENV = "DEVC_KRUN"

# OCI runtime of crun-krun, which runs the container as a microVM
KRUN_RUNTIME = "krun"

HOME = Path.home()
EXIT_SIGNALS = {signal.SIGHUP, signal.SIGTERM}


class DevcError(Exception):
    """A user-facing error, reported without a traceback."""


def info(msg: str) -> None:
    # The terminal may already be gone during cleanup (e.g. closed kitty window)
    try:
        print(msg, file=sys.stderr)
    except OSError:
        pass


def contains_home(path: Path) -> bool:
    return path == HOME or path in HOME.parents


def logical_cwd() -> Path:
    # Prefer the logical $PWD (like the shell), so symlinked paths hash as written
    cwd = Path.cwd()
    pwd = Path(os.environ.get("PWD", ""))
    if pwd.is_absolute():
        try:
            if pwd.samefile(cwd):
                return Path(os.path.normpath(pwd))
        except OSError:
            pass
    return cwd


def logical_path(path: Path, base: Path) -> Path:
    """Make a path absolute (relative to base) without resolving symlinks."""
    return Path(os.path.normpath(base / path.expanduser()))


# --- podman ------------------------------------------------------------------


def podman(
    *args: str, check: bool = True, **kwargs: Any
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(["podman", *args], check=check, text=True, **kwargs)


def podman_output(*args: str) -> str:
    return podman(*args, check=False, capture_output=True).stdout.strip()


def podman_quiet(*args: str) -> None:
    """Run podman for its side effect only, ignoring output and failure."""
    podman(*args, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def ensure_podman_machine() -> None:
    if platform.system() != "Darwin":
        return
    if not podman_output("machine", "list", "--format", "{{.Name}}"):
        info("No podman machine found, initializing...")
        podman("machine", "init")
    running = podman_output("machine", "list", "--format", "{{.Running}}").splitlines()
    if not running or running[0] != "true":
        info("Starting podman machine...")
        podman("machine", "start")


def ensure_image(build: bool) -> None:
    if not build and podman("image", "exists", IMAGE, check=False).returncode == 0:
        return
    script_dir = Path(__file__).resolve().parent
    dotfiles_root = Path(
        subprocess.run(
            ["git", "-C", script_dir, "rev-parse", "--show-toplevel"],
            check=True,
            text=True,
            capture_output=True,
        ).stdout.strip()
    )
    info(f"Building image {IMAGE}...")
    podman(
        "build",
        "-t",
        IMAGE,
        "-f",
        str(dotfiles_root / "Dockerfile"),
        str(dotfiles_root),
    )


def image_user() -> tuple[str, str]:
    """Return the (uid, gid) of the image's default user."""
    output = podman(
        "run",
        "--rm",
        IMAGE,
        "sh",
        "-c",
        'echo "$(id -u) $(id -g)"',
        capture_output=True,
    ).stdout
    uid, gid = output.split()
    return uid, gid


def is_running(container: str) -> bool:
    return (
        podman_output(
            "container", "inspect", container, "--format", "{{.State.Running}}"
        )
        == "true"
    )


# --- project -----------------------------------------------------------------


def _check_mount_destination(entry: Path, info: ValidationInfo) -> Path:
    """Turn a mount path into an absolute path, relative to the project."""
    project: Path = info.context["project"]
    # Keep the path as written (no symlink resolution), so symlinks pointing there resolve
    dest = logical_path(entry, project)
    source = dest.resolve()
    if ":" in str(dest) or ":" in str(source):
        raise ValueError(f"mount path must not contain ':': {dest}")
    if contains_home(dest) or contains_home(source):
        raise ValueError(f"refusing to mount {dest}: it contains your home directory")
    return dest


def _check_mount_source(entry: Path, info: ValidationInfo) -> Path:
    """Turn a mount path into an absolute path, relative to the project."""
    dest = _check_mount_destination(entry, info)
    source = dest.resolve()
    if not source.exists():
        raise ValueError(f"mount path does not exist: {dest}")
    return dest


def _check_container_path(entry: Path, info: ValidationInfo) -> PurePosixPath:
    """Turn a container path into an absolute path, with ~ as the container's home."""
    project: Path = info.context["project"]
    parts = PurePosixPath(entry).parts
    if parts and parts[0] == "~":
        path = CONTAINER_HOME.joinpath(*parts[1:])
    elif parts and parts[0].startswith("~"):
        raise ValueError(f"only ~ is supported, not ~user: {entry}")
    else:
        path = PurePosixPath(project) / entry
    path = PurePosixPath(os.path.normpath(path))
    if ":" in str(path):
        raise ValueError(f"mount path must not contain ':': {path}")
    if path in {CONTAINER_HOME, *CONTAINER_HOME.parents}:
        raise ValueError(
            f"refusing to mount over {path}: it contains the home directory"
        )
    return path


def _check_volume_name(name: str) -> str:
    if not NAMESPACE_PATTERN.fullmatch(name):
        raise ValueError(
            "must start with a letter or digit, followed by letters, digits, '_', '.' or '-'"
        )
    return name


class BindMount(BaseModel):
    """A host path, mounted read-only or read-write."""

    model_config = ConfigDict(extra="forbid", frozen=True)

    # Absolute or relative to the project, mounted at the same path in the container
    path: Annotated[Path, AfterValidator(_check_mount_source)]
    destination: Annotated[Path | None, AfterValidator(_check_mount_destination)] = None
    mode: Literal["ro", "rw"] = "ro"

    @property
    def source(self) -> Path:
        return self.path.resolve()

    @property
    def target(self) -> Path:
        return self.destination or self.path

    def podman_args(self, project: "Project") -> list[str]:
        args = ["-v", f"{self.source}:{self.target}:{self.mode},z"]
        # Like the project's, so the container can't rewrite history or plant hooks
        git_dir = self.source / GIT_DIR
        if self.mode == "rw" and git_dir.exists():
            args += ["-v", f"{git_dir}:{self.target / GIT_DIR}:ro,z"]
        return args


class PersistentMount(BaseModel):
    """A volume persisted per project and namespace."""

    model_config = ConfigDict(extra="forbid", frozen=True)

    # Path in the container, absolute, relative to the project or starting with ~
    path: Annotated[PurePosixPath, AfterValidator(_check_container_path)]
    mode: Literal["persistent"]
    # Volume component, defaults to one derived from the path
    name: Annotated[str | None, AfterValidator(_check_volume_name)] = None

    def volume_component(self, project: Path) -> str:
        if self.name:
            return self.name
        # Relative to the home or project, e.g. ~/.claude -> claude, ~/.a/b -> a-b
        path = self.path
        for base in (CONTAINER_HOME, PurePosixPath(project)):
            if path.is_relative_to(base):
                path = path.relative_to(base)
                break
        parts = (part.lstrip(".") for part in path.parts if part != "/")
        return re.sub(r"[^a-zA-Z0-9_.-]", "-", "-".join(p for p in parts if p))

    def podman_args(self, project: "Project") -> list[str]:
        volume = project.volume(self.volume_component(project.path))
        return ["-v", f"{volume}:{self.path}"]


def _mount_kind(value: object) -> str:
    mode = (
        value.get("mode") if isinstance(value, dict) else getattr(value, "mode", None)
    )
    return "persistent" if mode == "persistent" else "bind"


def _mount_shorthand(value: object) -> object:
    """Allow just a path, for a read-only bind mount."""
    return {"path": value} if isinstance(value, str) else value


# Given as `{path: ..., mode: ro|rw|persistent}` or just its path (read-only)
Mount = Annotated[
    Annotated[BindMount, Tag("bind")] | Annotated[PersistentMount, Tag("persistent")],
    Discriminator(_mount_kind),
]


PORT_PATTERN = re.compile(
    r"(?:(?P<host>\d+):)?(?P<container>\d+)(?:/(?P<protocol>\w+))?"
)

PortNumber = Annotated[int, Field(ge=1, le=65535)]


class Port(BaseModel):
    """A port forwarding, given as `{container: ..., host: ...}` or `[host:]container[/tcp|udp]`."""

    model_config = ConfigDict(extra="forbid", frozen=True)

    container: PortNumber
    # Defaults to the container port
    host: PortNumber | None = None
    # Only reachable from this machine by default
    host_ip: IPv4Address | IPv6Address = IPv4Address("127.0.0.1")
    protocol: Literal["tcp", "udp"] = "tcp"

    @model_validator(mode="before")
    @classmethod
    def _shorthand(cls, value: object) -> object:
        if isinstance(value, int):
            return {"container": value}
        if isinstance(value, str):
            match = PORT_PATTERN.fullmatch(value)
            if not match:
                raise ValueError(f"expected [host:]container[/tcp|udp], got {value!r}")
            return {k: v for k, v in match.groupdict().items() if v is not None}
        return value

    def podman_args(self) -> list[str]:
        host_ip = (
            f"[{self.host_ip}]" if self.host_ip.version == 6 else str(self.host_ip)
        )
        host = self.host or self.container
        return ["-p", f"{host_ip}:{host}:{self.container}/{self.protocol}"]


class Config(BaseModel):
    """Settings, read from the global config and <project>/.local_env/devc_config.yaml.

    Both are merged, global entries first. Relative paths are relative to the project.
    Example:

        mounts:
          - ../shared                                    # read-only, same path
          - {path: ../lib, destination: /work/lib, mode: rw}
          - {path: ~/.claude, mode: persistent}          # ~ = the container's home
          - {path: node_modules, mode: persistent}       # inside the project
          - {path: /opt/cache, mode: persistent, name: optcache}
        ports:
          - 3000                                         # 127.0.0.1:3000 -> 3000
          - "8080:80"                                    # host:container
          - "53/udp"
          - {container: 9000, host: 9001, host_ip: "0.0.0.0"}
    """

    model_config = ConfigDict(extra="forbid", frozen=True)

    mounts: list[Annotated[Mount, BeforeValidator(_mount_shorthand)]] = []
    ports: list[Port] = []

    @field_validator("mounts", "ports", mode="before")
    @classmethod
    def _null_as_empty(cls, value: object) -> object:
        # A bare `mounts:` key parses as null
        return [] if value is None else value

    @property
    def bind_mounts(self) -> list[BindMount]:
        return [mount for mount in self.mounts if isinstance(mount, BindMount)]

    @property
    def persistent_mounts(self) -> list[PersistentMount]:
        return [mount for mount in self.mounts if isinstance(mount, PersistentMount)]

    def merge(self, other: Self) -> Self:
        return type(self).model_construct(
            mounts=[*self.mounts, *other.mounts], ports=[*self.ports, *other.ports]
        )

    def check_volumes(self, project: Path) -> None:
        """Ensure each persistent mount gets its own volume."""
        paths: dict[str, PurePosixPath] = {}
        for mount in self.persistent_mounts:
            component = mount.volume_component(project)
            other = paths.setdefault(component, mount.path)
            if other != mount.path:
                raise DevcError(
                    f"persistent mounts {other} and {mount.path} share the volume name"
                    f" {component!r}, give one of them another `name`"
                )

    @classmethod
    def load(cls, path: Path, project: Path) -> Self:
        if not path.is_file():
            return cls()
        try:
            data = yaml.safe_load(path.read_text()) or {}
        except yaml.YAMLError as e:
            raise DevcError(f"{path}: invalid YAML: {e}") from e
        try:
            return cls.model_validate(data, context={"project": project})
        except ValidationError as e:
            lines = (
                f"  {'.'.join(map(str, _error_loc(err['loc']))) or '<root>'}: {err['msg']}"
                for err in e.errors()
            )
            raise DevcError(f"{path}: invalid config:\n" + "\n".join(lines)) from e


def _error_loc(loc: tuple[int | str, ...]) -> tuple[int | str, ...]:
    """Drop the tag of the mount kind, which isn't part of the config."""
    if loc[:1] == ("mounts",) and len(loc) > 2 and loc[2] in {"bind", "persistent"}:
        return loc[:2] + loc[3:]
    return loc


@dataclass(frozen=True)
class Project:
    path: Path
    namespace: str = DEFAULT_NAMESPACE

    def __str__(self) -> str:
        return f"{self.path} ({self.namespace})"

    @cached_property
    def hash(self) -> str:
        return hashlib.sha256(str(self.path).encode()).hexdigest()[:16]

    @property
    def container(self) -> str:
        return f"devc-{self.hash}-{self.namespace}"

    def new_microvm(self) -> str:
        """A unique name for another microVM.

        Starting with "vm" rather than the hash, so it can't clash with the container
        of another namespace.
        """
        return f"devc-vm-{self.hash}-{self.namespace}-{secrets.token_hex(4)}"

    def microvms(self, *, active: bool = True) -> list[str]:
        """The project's microVMs, by default only those starting or running."""
        status = ["--filter", "status=created", "--filter", "status=running"]
        return podman_output(
            "ps", "-a", "--format", "{{.Names}}",
            "--filter", f"label={PROJECT_LABEL}={self.path}",
            "--filter", f"label={NAMESPACE_LABEL}={self.namespace}",
            "--filter", f"label={MICROVM_LABEL}",
            *(status if active else []),
        ).splitlines()  # fmt: skip

    def in_use(self) -> bool:
        return is_running(self.container) or bool(self.microvms())

    def volume(self, component: str) -> str:
        # Readable, but still unique per project path thanks to the hash
        name = re.sub(r"[^a-zA-Z0-9_.-]", "-", self.path.name)
        return f"devc-{name}-{self.hash[:8]}-{self.namespace}-{component}"

    def volumes(self, config: Config) -> list[str]:
        """The volumes to mount, as configured."""
        return [
            self.volume(mount.volume_component(self.path))
            for mount in config.persistent_mounts
        ]

    def existing_volumes(self) -> list[str]:
        """All volumes of the project, including ones no longer configured."""
        return podman_output(
            "volume", "ls", "--format", "{{.Name}}",
            "--filter", f"label={PROJECT_LABEL}={self.path}",
            "--filter", f"label={NAMESPACE_LABEL}={self.namespace}",
        ).splitlines()  # fmt: skip

    @property
    def label_args(self) -> list[str]:
        return [
            "--label", f"{PROJECT_LABEL}={self.path}",
            "--label", f"{NAMESPACE_LABEL}={self.namespace}",
        ]  # fmt: skip

    @property
    def session_name(self) -> str:
        if self.namespace == DEFAULT_NAMESPACE:
            return self.path.name
        return f"{self.path.name}:{self.namespace}"

    @property
    def local_env(self) -> Path:
        return self.path / LOCAL_ENV

    @property
    def config_file(self) -> Path:
        return self.local_env / CONFIG_FILE

    @property
    def git_dir(self) -> Path:
        return self.path / GIT_DIR

    def load_config(self) -> Config:
        global_config = Config.load(GLOBAL_CONFIG_FILE, self.path)
        config = global_config.merge(Config.load(self.config_file, self.path))
        config.check_volumes(self.path)
        return config

    def check_workdir(self, workdir: Path, config: Config) -> None:
        """Ensure the container can open in workdir, i.e. it's mounted there."""
        roots = [self.path, *(mount.path for mount in config.bind_mounts)]
        if not any(workdir.is_relative_to(root) for root in roots):
            raise DevcError(
                f"{workdir} is not mounted in the container of {self.path}, "
                f"add it to the mounts in {self.config_file}"
            )


# --- container lifecycle -----------------------------------------------------


def prepare_container(project: Project, config: Config) -> tuple[str, str]:
    """Create the local env and the volumes, returning the image's user."""
    if not (project.local_env.exists() or project.local_env.is_symlink()):
        project.local_env.mkdir()
    uid, gid = image_user()

    # Created up front rather than by `podman run`, to carry the labels
    for volume in project.volumes(config):
        if podman("volume", "exists", volume, check=False).returncode != 0:
            podman(
                "volume", "create", *project.label_args, volume,
                stdout=subprocess.DEVNULL,
            )  # fmt: skip
    return uid, gid


def start_container(project: Project, config: Config) -> None:
    info("Starting dev container...")
    uid, gid = prepare_container(project, config)
    podman_quiet("rm", "-f", project.container)
    podman(*run_command(project, config, uid, gid), stdout=subprocess.DEVNULL)


def create_microvm(
    project: Project, config: Config, name: str, workdir: Path, command: list[str]
) -> None:
    info("Starting dev microVM...")
    uid, gid = prepare_container(project, config)
    podman(
        *krun_command(project, config, name, uid, gid, workdir, command),
        stdout=subprocess.DEVNULL,
    )


def run_command(project: Project, config: Config, uid: str, gid: str) -> list[str]:
    """The podman arguments that start the project's container."""
    run_args = [
        "-d",
        "--init",
        *container_args(project, config, project.container, uid, gid),
    ]
    return ["run", *run_args, IMAGE, "sleep", "infinity"]


def krun_command(
    project: Project,
    config: Config,
    name: str,
    uid: str,
    gid: str,
    workdir: Path,
    command: list[str],
) -> list[str]:
    """The podman arguments that create a microVM of the project, running the command.

    podman exec doesn't work with krun, so the command is the microVM's main process
    rather than `sleep infinity`. Created rather than run, so it is already listed as
    in use when the session lock is released.
    """
    create_args = [
        "--runtime", KRUN_RUNTIME,
        # Removed by podman when it exits, even if devc is killed
        "--rm",
        "--label", f"{MICROVM_LABEL}=true",
        *container_args(project, config, name, uid, gid),
        *session_args(project, workdir),
    ]  # fmt: skip
    return ["create", *create_args, IMAGE, *drop_privileges(uid, gid), *command]


def drop_privileges(uid: str, gid: str) -> list[str]:
    """The command prefix that runs a command as the image's user, without capabilities.

    krun's init runs the command as root in the microVM, ignoring the image's user.
    The podman options restricting privileges apply to the microVM process on the
    host, not inside it, so they are applied to the command here.
    """
    return [
        "setpriv",
        f"--reuid={uid}",
        f"--regid={gid}",
        "--init-groups",
        "--inh-caps=-all",
        "--ambient-caps=-all",
        "--bounding-set=-all",
        "--no-new-privs",
        "--",
    ]


def container_args(
    project: Project, config: Config, name: str, uid: str, gid: str
) -> list[str]:
    """The podman arguments that set up a container of the project, for any runtime."""
    run_args = [
        "--name", name,
        *project.label_args,
        f"--userns=keep-id:uid={uid},gid={gid}",
        "--cap-drop=all",
        "--security-opt=no-new-privileges",
        *git_safe_directory_args([project.path, *(m.target for m in config.bind_mounts)]),
        "-v", f"{project.path}:{project.path}:z",
        "-v", f"{project.local_env}:{project.local_env}:ro,z",
    ]  # fmt: skip
    # A file for worktrees and submodules, mounted the same way
    if project.git_dir.exists():
        run_args += ["-v", f"{project.git_dir}:{project.git_dir}:ro,z"]
    for mount in config.mounts:
        run_args += mount.podman_args(project)
    for port in config.ports:
        run_args += port.podman_args()
    return run_args


def git_safe_directory_args(paths: list[Path]) -> list[str]:
    """Let git trust the repos in and below the given paths, whatever their owner.

    Mounted files can appear owned by another user (e.g. through the podman machine
    on macOS), which git refuses as dubious ownership.
    """
    values = [value for path in paths for value in (str(path), f"{path}/*")]
    args = ["-e", f"GIT_CONFIG_COUNT={len(values)}"]
    for i, value in enumerate(values):
        args += [
            "-e", f"GIT_CONFIG_KEY_{i}=safe.directory",
            "-e", f"GIT_CONFIG_VALUE_{i}={value}",
        ]  # fmt: skip
    return args


def remove_container(project: Project) -> None:
    """Remove the project's containers and persisted volumes."""
    podman_quiet("rm", "-f", project.container, *project.microvms(active=False))
    for volume in project.existing_volumes():
        podman_quiet("volume", "rm", "-f", volume)


class SessionCounter:
    """Counts the devc sessions attached to a container, so the last one to exit stops it."""

    def __init__(self, container: str) -> None:
        state_dir = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / "devc"
        state_dir.mkdir(parents=True, exist_ok=True)
        self._lock_file = state_dir / f"{container}.lock"
        self._count_file = state_dir / f"{container}.count"

    @contextmanager
    def locked(self) -> Iterator[None]:
        with self._lock_file.open("w") as f:
            fcntl.flock(f, fcntl.LOCK_EX)
            try:
                yield
            finally:
                fcntl.flock(f, fcntl.LOCK_UN)

    def get(self, default: int) -> int:
        try:
            return int(self._count_file.read_text().strip())
        except (OSError, ValueError):
            return default

    def set(self, count: int) -> None:
        self._count_file.write_text(f"{count}\n")

    def clear(self) -> None:
        self._count_file.unlink(missing_ok=True)


def _exit_on_signal(signum: int, _frame: FrameType | None) -> None:
    sys.exit(128 + signum)


def reset_project(project: Project, sessions: SessionCounter) -> None:
    """Remove the project's container and volumes, to be called with the lock held."""
    # They would lose their volumes while still using them
    if project.microvms():
        raise DevcError(f"{project} has running microVMs, exit them first")
    info("Resetting persisted volumes for this project...")
    remove_container(project)
    sessions.clear()


@contextmanager
def session(project: Project, config: Config, reset: bool) -> Iterator[None]:
    """Start the container if needed and keep it running for the duration of the block."""
    sessions = SessionCounter(project.container)
    for sig in EXIT_SIGNALS:
        signal.signal(sig, _exit_on_signal)

    with sessions.locked():
        if reset:
            reset_project(project, sessions)
        if not is_running(project.container):
            start_container(project, config)
            sessions.set(0)
        # Defer exit signals until the try below, so the session is always released
        signal.pthread_sigmask(signal.SIG_BLOCK, EXIT_SIGNALS)
        sessions.set(sessions.get(0) + 1)

    try:
        signal.pthread_sigmask(signal.SIG_UNBLOCK, EXIT_SIGNALS)
        yield
    finally:
        for sig in EXIT_SIGNALS:
            signal.signal(sig, signal.SIG_IGN)
        with sessions.locked():
            remaining = sessions.get(1) - 1
            if remaining <= 0:
                info("Stopping container...")
                podman_quiet("rm", "-f", project.container)
                sessions.clear()
            else:
                sessions.set(remaining)


@contextmanager
def microvm_session(
    project: Project,
    config: Config,
    reset: bool,
    workdir: Path,
    command: list[str],
) -> Iterator[str]:
    """Create a microVM running the command, to be started in the block, and remove it after.

    podman exec doesn't work with krun, so a microVM can't be shared between sessions
    like a container. Instead, each session gets its own, with the same mounts.
    """
    sessions = SessionCounter(project.container)
    for sig in EXIT_SIGNALS:
        signal.signal(sig, _exit_on_signal)
    name = project.new_microvm()

    # Locked, so --reset, --rm or --prune can't remove the volumes meanwhile
    with sessions.locked():
        if reset:
            reset_project(project, sessions)
        # Defer exit signals until the try below, so the microVM is always removed
        signal.pthread_sigmask(signal.SIG_BLOCK, EXIT_SIGNALS)
        create_microvm(project, config, name, workdir, command)

    try:
        signal.pthread_sigmask(signal.SIG_UNBLOCK, EXIT_SIGNALS)
        yield name
    finally:
        for sig in EXIT_SIGNALS:
            signal.signal(sig, signal.SIG_IGN)
        info("Stopping microVM...")
        podman_quiet("rm", "-f", name)


def attach(project: Project, workdir: Path, args: list[str], krun: bool) -> int:
    """Run podman attached to the terminal, for a session in the project's container."""
    # Ctrl-C is meant for the command inside the container. A no-op handler
    # rather than SIG_IGN, since ignored signals are inherited by podman
    signal.signal(signal.SIGINT, lambda *_: None)
    # Lets kitty's devc_window.py recognize devc windows and open another one like it
    env = {
        **os.environ,
        PROJECT_ENV: str(project.path),
        NAMESPACE_ENV: project.namespace,
        WORKDIR_ENV: str(workdir),
        **({KRUN_ENV: "1"} if krun else {}),
    }
    return podman(*args, check=False, env=env).returncode


def exec_command(project: Project, workdir: Path, command: list[str]) -> list[str]:
    """The podman arguments that run the command in the project's container."""
    return ["exec", *session_args(project, workdir), project.container, *command]


def start_microvm_command(name: str) -> list[str]:
    """The podman arguments that start the microVM, attached to it."""
    return ["start", "--attach", "--interactive", name]


def session_args(project: Project, workdir: Path) -> list[str]:
    """The podman arguments for running a session's command, of exec or create."""
    return [
        "--workdir", str(workdir),
        "--env", f"TERM={os.environ.get('TERM') or 'xterm'}",
        "--env", f"DEVC_SESSION_NAME={project.session_name}",
        "-it" if sys.stdin.isatty() and sys.stdout.isatty() else "-i",
    ]  # fmt: skip


# --- project management ------------------------------------------------------


def all_projects() -> list[Project]:
    """All projects and namespaces that have volumes."""
    volumes = json.loads(
        podman_output(
            "volume", "ls", "--filter", f"label={PROJECT_LABEL}", "--format", "json"
        )
        or "[]"
    )
    return sorted(
        {
            Project(Path(v["Labels"][PROJECT_LABEL]), v["Labels"][NAMESPACE_LABEL])
            for v in volumes
        },
        key=lambda p: (str(p.path), p.namespace),
    )


def list_projects() -> None:
    projects = all_projects()
    if not projects:
        info("No devc projects found")
        return

    rows = [("PROJECT", "NAMESPACE", "STATUS")]
    for project in projects:
        running = []
        if is_running(project.container):
            count = SessionCounter(project.container).get(0)
            running.append(f"{count} session{'s' * (count != 1)}")
        if microvms := len(project.microvms()):
            running.append(f"{microvms} microVM{'s' * (microvms != 1)}")
        status = f"running ({', '.join(running)})" if running else "stopped"
        if not project.path.is_dir():
            status += ", directory missing"
        rows.append((str(project.path), project.namespace, status))
    widths = [max(len(row[i]) for row in rows) for i in range(2)]
    for path, namespace, status in rows:
        print(f"{path:<{widths[0]}}  {namespace:<{widths[1]}}  {status}")


def remove_project(project: Project) -> None:
    sessions = SessionCounter(project.container)
    with sessions.locked():
        if project.in_use():
            raise DevcError(f"{project} is running, exit its sessions first")
        if not project.existing_volumes():
            raise DevcError(f"No devc project {project}")
        info(f"Removing {project}...")
        remove_container(project)
        sessions.clear()


def remove_all_projects() -> None:
    """Delete the containers and volumes of all projects and namespaces."""
    projects = all_projects()
    if not projects:
        info("No devc projects found")
        return
    # Checked up front, so nothing is removed if any of them is still in use
    running = [project for project in projects if project.in_use()]
    if running:
        raise DevcError(
            "Exit the sessions of these projects first:\n"
            + "\n".join(f"  {project}" for project in running)
        )
    info("This deletes the volumes of:")
    for project in projects:
        info(f"  {project}")
    if not typer.confirm("Continue?", err=True):
        raise DevcError("Aborted")
    for project in projects:
        remove_project(project)


def prune_project(project: Project) -> None:
    """Delete the project's volumes that are no longer used by its config."""
    config = project.load_config()
    sessions = SessionCounter(project.container)
    with sessions.locked():
        # The containers may still use volumes from the config they were started with
        if project.in_use():
            raise DevcError(f"{project} is running, exit its sessions first")
        configured = set(project.volumes(config))
        orphaned = [v for v in project.existing_volumes() if v not in configured]
        if not orphaned:
            info(f"No unused volumes for {project}")
            return
        for volume in orphaned:
            info(f"Removing {volume}...")
        podman("volume", "rm", *orphaned, stdout=subprocess.DEVNULL)


# --- cli ---------------------------------------------------------------------

app = typer.Typer(add_completion=False, pretty_exceptions_enable=False)


def _check_namespace(value: str) -> str:
    if not NAMESPACE_PATTERN.fullmatch(value):
        raise typer.BadParameter(
            "must start with a letter or digit, followed by letters, digits, '_', '.' or '-'"
        )
    return value


def dry_run(
    project: Project, workdir: Path, command: list[str], config: Config, krun: bool
) -> None:
    """Print the podman commands that start the container and run the command."""
    ensure_podman_machine()
    # The user is only known from the image, which isn't built in a dry run
    if podman("image", "exists", IMAGE, check=False).returncode == 0:
        uid, gid = image_user()
    else:
        info(f"Image {IMAGE} not built yet, the user is a placeholder")
        uid, gid = "<uid>", "<gid>"
    if krun:
        name = project.new_microvm()
        print(
            format_command(
                krun_command(project, config, name, uid, gid, workdir, command)
            )
        )
        print(format_command(start_microvm_command(name)))
    else:
        print(format_command(run_command(project, config, uid, gid)))
        print(format_command(exec_command(project, workdir, command)))


# Options of podman run and exec that take their value as the next argument
VALUE_OPTIONS = {
    "--name", "--label", "-e", "--env", "-v", "-p", "--workdir", "--runtime"
}  # fmt: skip


def format_command(args: list[str]) -> str:
    """Format podman arguments as a shell command, one option per line."""
    subcommand, *rest = args
    lines = [shlex.join(["podman", subcommand])]
    i = 0
    while i < len(rest) and rest[i].startswith("-"):
        width = 2 if rest[i] in VALUE_OPTIONS else 1
        lines.append(shlex.join(rest[i : i + width]))
        i += width
    # The image or container, followed by the command
    if rest[i:]:
        lines.append(shlex.join(rest[i:]))
    return " \\\n    ".join(lines)


def run(
    project: Project,
    workdir: Path,
    command: list[str],
    reset: bool,
    build: bool,
    dry: bool,
    krun: bool,
) -> int:
    if not project.path.is_dir():
        raise DevcError(f"Project directory {project.path} does not exist")
    if contains_home(project.path):
        raise DevcError(
            f"Refusing to run in {project.path}: it contains your home directory"
        )
    config = project.load_config()
    project.check_workdir(workdir, config)

    if dry:
        dry_run(project, workdir, command, config, krun)
        return 0

    ensure_podman_machine()
    ensure_image(build)

    if krun:
        with microvm_session(project, config, reset, workdir, command) as name:
            return attach(project, workdir, start_microvm_command(name), krun)
    with session(project, config, reset):
        return attach(project, workdir, exec_command(project, workdir, command), krun)


# Stop option parsing at the command, so its own flags are passed through
@app.command(
    context_settings={"allow_interspersed_args": False, "ignore_unknown_options": True}
)
def main(
    command: Annotated[
        list[str] | None,
        typer.Argument(help="Command to run inside the container.", show_default="zsh"),
    ] = None,
    project_dir: Annotated[
        Path | None,
        typer.Option(
            "--project",
            "-p",
            help="Project directory whose container to use. The command still runs"
            " in the current directory, which must be mounted.",
            show_default="current directory",
        ),
    ] = None,
    namespace: Annotated[
        str,
        typer.Option(
            "--namespace",
            "-n",
            help="Independent container and volumes for the same project.",
            callback=_check_namespace,
        ),
    ] = DEFAULT_NAMESPACE,
    reset: Annotated[
        bool,
        typer.Option("--reset", help="Delete the project's persisted volumes first."),
    ] = False,
    build: Annotated[
        bool, typer.Option("--build", help="Rebuild the image, even if it exists.")
    ] = False,
    krun: Annotated[
        bool,
        typer.Option(
            "--krun",
            help="Run in a microVM with crun-krun. Each session gets its own,"
            " with the same mounts.",
        ),
    ] = False,
    list_: Annotated[
        bool, typer.Option("--list", help="List all projects and their namespaces.")
    ] = False,
    remove: Annotated[
        bool,
        typer.Option(
            "--rm", help="Delete the project's container and volumes in the namespace."
        ),
    ] = False,
    prune: Annotated[
        bool,
        typer.Option(
            "--prune",
            help="Delete the project's volumes in the namespace that its config"
            " no longer uses, e.g. of removed persistent mounts.",
        ),
    ] = False,
    remove_all: Annotated[
        bool,
        typer.Option(
            "--rm-all",
            help="Delete the containers and volumes of all projects and namespaces.",
        ),
    ] = False,
    dry: Annotated[
        bool,
        typer.Option(
            "--dry-run",
            help="Only print the podman commands that start the container"
            " and run the command.",
        ),
    ] = False,
) -> None:
    """Run a command (default: zsh) inside a per-project dev container."""
    returncode = 0
    try:
        if list_ and (
            remove or prune or remove_all or dry or command or project_dir or reset
            or build or krun
        ):  # fmt: skip
            raise DevcError("--list can't be combined with other options or a command")
        if remove_all and (
            remove or prune or dry or command or project_dir or reset or build
            or krun or namespace != DEFAULT_NAMESPACE
        ):  # fmt: skip
            raise DevcError(
                "--rm-all can't be combined with other options or a command"
            )
        if remove and (prune or dry or command or reset or build or krun):
            raise DevcError("--rm can only be combined with --project and --namespace")
        if prune and (dry or command or reset or build or krun):
            raise DevcError(
                "--prune can only be combined with --project and --namespace"
            )
        if dry and (reset or build):
            raise DevcError("--dry-run can't be combined with --reset or --build")

        workdir = logical_cwd()
        project_path = logical_path(project_dir, workdir) if project_dir else workdir
        project = Project(project_path, namespace)

        if list_:
            ensure_podman_machine()
            list_projects()
        elif remove_all:
            ensure_podman_machine()
            remove_all_projects()
        elif remove:
            ensure_podman_machine()
            remove_project(project)
        elif prune:
            ensure_podman_machine()
            prune_project(project)
        else:
            returncode = run(
                project, workdir, command or ["zsh"], reset, build, dry, krun
            )
    except DevcError as e:
        info(str(e))
        raise typer.Exit(1) from e
    except subprocess.CalledProcessError as e:
        # podman already reported the error
        raise typer.Exit(e.returncode) from e
    raise typer.Exit(returncode)


if __name__ == "__main__":
    app()
