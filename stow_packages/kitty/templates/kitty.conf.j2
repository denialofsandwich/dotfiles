######################################################################
### This file is automatically generated using a jinja template!!! ###
######################################################################

allow_remote_control yes
listen_on unix:/tmp/kitty
shell_integration enabled

{%- if FORCE_ZSH == "yes" %}

### Dynamically selected if FORCE_ZSH=yes
shell zsh

{% endif -%}

enable_audio_bell no
visual_bell_duration 0.0
window_alert_on_bell no
notify_on_cmd_finish invisible 10.0
scrollback_pager_history_size 10

tab_bar_style powerline
tab_bar_edge top
tab_powerline_style slanted
tab_title_template "{custom}"

enabled_layouts tall:bias=60;full_size=1;mirrored=false,fat:bias=60;full_size=1;mirrored=false,stack
window_border_width 1.5pt
draw_minimal_borders no

cursor_trail 50
cursor_trail_decay 0.05 0.35
cursor_trail_start_threshold 2

palette_generate semantic

map kitty_mod+up previous_window
map kitty_mod+down next_window
map kitty_mod+s move_window_to_top
map kitty_mod+enter new_window_with_cwd
map kitty_mod+ä set_tab_title
map kitty_mod+# combine : first_window : toggle_layout stack
map kitty_mod+ü macos_cycle_through_os_windows

action_alias kitty_scrollback_nvim kitten '~/.local/share/nvim/lazy/kitty-scrollback.nvim/python/kitty_scrollback_nvim.py'
map kitty_mod+h kitty_scrollback_nvim
map kitty_mod+g kitty_scrollback_nvim --config ksb_builtin_last_cmd_output
mouse_map ctrl+shift+right press ungrabbed combine : mouse_select_command_output : kitty_scrollback_nvim --config ksb_builtin_last_visited_cmd_output

# BEGIN_KITTY_FONTS
font_family      family="Hack Nerd Font"
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS
font_size 9.0

# neovim fixes
map ctrl+shift+minus send_text all \x1f
map ctrl+shift+7 send_text all \x1f
map kitty_mod+home change_font_size all -2.0

map kitty_mod+a>g goto_session --sort-by=alphabetical ~/.config/kitty/sessions
map kitty_mod+a>c goto_session --sort-by=alphabetical ~/.kitty-sessions
map kitty_mod+a>w save_as_session --use-foreground-process --base-dir ~/.kitty-sessions

# Fix issue with virtual keyboards and multi-key shortcuts
wayland_enable_ime no

{%- if OS_TYPE == "macos" %}

### From here dynamically selected if OS_TYPE=macos
font_size 11.0

# Default key
kitty_mod cmd+shift

# neovim fixes
map cmd+shift+minus send_text all \x1f
map cmd+shift+7 send_text all \x1f
map kitty_mod+home change_font_size all -2.0

map kitty_mod+m macos_cycle_through_os_windows

# Ctrl+Key fixes
map cmd+a send_key ctrl+a
map cmd+b send_key ctrl+b
map cmd+c send_key ctrl+c
map cmd+d send_key ctrl+d
map cmd+e send_key ctrl+e
map cmd+f send_key ctrl+f
map cmd+g send_key ctrl+g
map cmd+h send_key ctrl+h
map cmd+i send_key ctrl+i
map cmd+j send_key ctrl+j
map cmd+k send_key ctrl+k
map cmd+l send_key ctrl+l
map cmd+m send_key ctrl+m
map cmd+n send_key ctrl+n
map cmd+o send_key ctrl+o
map cmd+p send_key ctrl+p
map cmd+q send_key ctrl+q
map cmd+r send_key ctrl+r
map cmd+s send_key ctrl+s
map cmd+t send_key ctrl+t
map cmd+u send_key ctrl+u
map cmd+v send_key ctrl+v
map cmd+w send_key ctrl+w
map cmd+x send_key ctrl+x
map cmd+y send_key ctrl+y
map cmd+z send_key ctrl+z
map cmd+left  send_key ctrl+left
map cmd+right send_key ctrl+right
map cmd+backspace send_key ctrl+backspace
# To copy the mac native behaviour
map alt+backspace send_key ctrl+backspace
map alt+left      send_key ctrl+left
map alt+right     send_key ctrl+right
{% endif -%}
