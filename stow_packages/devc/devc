#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pydantic>=2", "pyyaml>=6", "typer>=0.12"]
# ///
"""Run a command (default: zsh) inside a per-project dev container."""

import fcntl
import hashlib
import json
import os
import platform
import re
import signal
import subprocess
import sys
from collections.abc import Iterator
from contextlib import contextmanager
from dataclasses import dataclass
from functools import cached_property
from pathlib import Path, PurePosixPath
from types import FrameType
from typing import Annotated, Any, Literal, Self

import typer
import yaml
from pydantic import (
    AfterValidator,
    BaseModel,
    ConfigDict,
    ValidationError,
    ValidationInfo,
    field_validator,
    model_validator,
)

IMAGE = "dotfiles-dev:latest"
CONTAINER_HOME = PurePosixPath("/home/dev")

# Mounted read-only, so the container can't tamper with activate.sh or the config
LOCAL_ENV = ".local_env"
CONFIG_FILE = "devc_config.yaml"

# Mounted read-only if present, so the container can't rewrite history or plant hooks
GIT_DIR = ".git"

# Container home subdirectory -> volume component, persisted per project and namespace
PERSISTED_DIRS = {
    ".cache": "cache",
    ".claude": "claude",
    ".local/share/nvim": "nvim",
    ".local/state": "state",
}

# Shell history is kept per project inside the persisted state volume
HISTORY_DIR = CONTAINER_HOME / ".local/state"

COPIED_FILES = [".ssh/config", ".gitconfig"]

# Namespaces allow several independent containers for the same project
DEFAULT_NAMESPACE = "main"
# Must be valid in container and volume names
NAMESPACE_PATTERN = re.compile(r"[a-zA-Z0-9][a-zA-Z0-9_.-]*")

# Set on containers and volumes, so projects can be listed
PROJECT_LABEL = "devc.project"
NAMESPACE_LABEL = "devc.namespace"

# Set on the host-side podman exec, must match stow_packages/kitty/configs/devc_window.py
PROJECT_ENV = "DEVC_PROJECT"
NAMESPACE_ENV = "DEVC_NAMESPACE"
WORKDIR_ENV = "DEVC_WORKDIR"

HOME = Path.home()
EXIT_SIGNALS = {signal.SIGHUP, signal.SIGTERM}


class DevcError(Exception):
    """A user-facing error, reported without a traceback."""


def info(msg: str) -> None:
    # The terminal may already be gone during cleanup (e.g. closed kitty window)
    try:
        print(msg, file=sys.stderr)
    except OSError:
        pass


def contains_home(path: Path) -> bool:
    return path == HOME or path in HOME.parents


def logical_cwd() -> Path:
    # Prefer the logical $PWD (like the shell), so symlinked paths hash as written
    cwd = Path.cwd()
    pwd = Path(os.environ.get("PWD", ""))
    if pwd.is_absolute():
        try:
            if pwd.samefile(cwd):
                return Path(os.path.normpath(pwd))
        except OSError:
            pass
    return cwd


def logical_path(path: Path, base: Path) -> Path:
    """Make a path absolute (relative to base) without resolving symlinks."""
    return Path(os.path.normpath(base / path.expanduser()))


# --- podman ------------------------------------------------------------------


def podman(
    *args: str, check: bool = True, **kwargs: Any
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(["podman", *args], check=check, text=True, **kwargs)


def podman_output(*args: str) -> str:
    return podman(*args, check=False, capture_output=True).stdout.strip()


def podman_quiet(*args: str) -> None:
    """Run podman for its side effect only, ignoring output and failure."""
    podman(*args, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def ensure_podman_machine() -> None:
    if platform.system() != "Darwin":
        return
    if not podman_output("machine", "list", "--format", "{{.Name}}"):
        info("No podman machine found, initializing...")
        podman("machine", "init")
    running = podman_output("machine", "list", "--format", "{{.Running}}").splitlines()
    if not running or running[0] != "true":
        info("Starting podman machine...")
        podman("machine", "start")


def ensure_image(build: bool) -> None:
    if not build and podman("image", "exists", IMAGE, check=False).returncode == 0:
        return
    script_dir = Path(__file__).resolve().parent
    dotfiles_root = Path(
        subprocess.run(
            ["git", "-C", script_dir, "rev-parse", "--show-toplevel"],
            check=True,
            text=True,
            capture_output=True,
        ).stdout.strip()
    )
    info(f"Building image {IMAGE}...")
    podman(
        "build",
        "-t",
        IMAGE,
        "-f",
        str(dotfiles_root / "Dockerfile"),
        str(dotfiles_root),
    )


def image_user() -> tuple[str, str]:
    """Return the (uid, gid) of the image's default user."""
    output = podman(
        "run",
        "--rm",
        IMAGE,
        "sh",
        "-c",
        'echo "$(id -u) $(id -g)"',
        capture_output=True,
    ).stdout
    uid, gid = output.split()
    return uid, gid


def is_running(container: str) -> bool:
    return (
        podman_output(
            "container", "inspect", container, "--format", "{{.State.Running}}"
        )
        == "true"
    )


# --- project -----------------------------------------------------------------


def _check_mount_destination(entry: Path, info: ValidationInfo) -> Path:
    """Turn a mount path into an absolute path, relative to the project."""
    project: Path = info.context["project"]
    # Keep the path as written (no symlink resolution), so symlinks pointing there resolve
    dest = logical_path(entry, project)
    source = dest.resolve()
    if ":" in str(dest) or ":" in str(source):
        raise ValueError(f"mount path must not contain ':': {dest}")
    if contains_home(dest) or contains_home(source):
        raise ValueError(f"refusing to mount {dest}: it contains your home directory")
    return dest


def _check_mount_source(entry: Path, info: ValidationInfo) -> Path:
    """Turn a mount path into an absolute path, relative to the project."""
    dest = _check_mount_destination(entry, info)
    source = dest.resolve()
    if not source.exists():
        raise ValueError(f"mount path does not exist: {dest}")
    return dest


class Mount(BaseModel):
    """An extra mount, given as `{path: ..., mode: ro|rw}` or just its path (read-only)."""

    model_config = ConfigDict(extra="forbid", frozen=True)

    # Absolute or relative to the project, mounted at the same path in the container
    path: Annotated[Path, AfterValidator(_check_mount_source)]
    destination: Annotated[Path | None, AfterValidator(_check_mount_destination)] = None
    mode: Literal["ro", "rw"] = "ro"

    @model_validator(mode="before")
    @classmethod
    def _path_shorthand(cls, value: object) -> object:
        return {"path": value} if isinstance(value, str) else value

    @property
    def source(self) -> Path:
        return self.path.resolve()

    def podman_args(self) -> list[str]:
        destination = self.destination or self.path
        args = ["-v", f"{self.source}:{destination}:{self.mode},z"]
        # Like the project's, so the container can't rewrite history or plant hooks
        git_dir = self.source / GIT_DIR
        if self.mode == "rw" and git_dir.exists():
            args += ["-v", f"{git_dir}:{self.path / GIT_DIR}:ro,z"]
        return args


class Config(BaseModel):
    """Per-project settings, read from <project>/.local_env/devc_config.yaml."""

    model_config = ConfigDict(extra="forbid", frozen=True)

    mounts: list[Mount] = []

    @field_validator("mounts", mode="before")
    @classmethod
    def _null_as_empty(cls, value: object) -> object:
        # A bare `mounts:` key parses as null
        return [] if value is None else value

    @classmethod
    def load(cls, path: Path, project: Path) -> Self:
        if not path.is_file():
            return cls()
        try:
            data = yaml.safe_load(path.read_text()) or {}
        except yaml.YAMLError as e:
            raise DevcError(f"{path}: invalid YAML: {e}") from e
        try:
            return cls.model_validate(data, context={"project": project})
        except ValidationError as e:
            lines = (
                f"  {'.'.join(map(str, err['loc'])) or '<root>'}: {err['msg']}"
                for err in e.errors()
            )
            raise DevcError(f"{path}: invalid config:\n" + "\n".join(lines)) from e


@dataclass(frozen=True)
class Project:
    path: Path
    namespace: str = DEFAULT_NAMESPACE

    def __str__(self) -> str:
        return f"{self.path} ({self.namespace})"

    @cached_property
    def hash(self) -> str:
        return hashlib.sha256(str(self.path).encode()).hexdigest()[:16]

    @property
    def container(self) -> str:
        return f"devc-{self.hash}-{self.namespace}"

    def volume(self, component: str) -> str:
        return f"devc-{component}-{self.hash}-{self.namespace}"

    @property
    def volumes(self) -> list[str]:
        return [self.volume(component) for component in PERSISTED_DIRS.values()]

    @property
    def label_args(self) -> list[str]:
        return [
            "--label", f"{PROJECT_LABEL}={self.path}",
            "--label", f"{NAMESPACE_LABEL}={self.namespace}",
        ]  # fmt: skip

    @property
    def session_name(self) -> str:
        if self.namespace == DEFAULT_NAMESPACE:
            return self.path.name
        return f"{self.path.name}:{self.namespace}"

    @property
    def local_env(self) -> Path:
        return self.path / LOCAL_ENV

    @property
    def config_file(self) -> Path:
        return self.local_env / CONFIG_FILE

    @property
    def git_dir(self) -> Path:
        return self.path / GIT_DIR

    def load_config(self) -> Config:
        return Config.load(self.config_file, self.path)

    def check_workdir(self, workdir: Path, config: Config) -> None:
        """Ensure the container can open in workdir, i.e. it's mounted there."""
        roots = [self.path, *(mount.path for mount in config.mounts)]
        if not any(workdir.is_relative_to(root) for root in roots):
            raise DevcError(
                f"{workdir} is not mounted in the container of {self.path}, "
                f"add it to the mounts in {self.config_file}"
            )


# --- container lifecycle -----------------------------------------------------


def start_container(project: Project, config: Config) -> None:
    info("Starting dev container...")

    if not (project.local_env.exists() or project.local_env.is_symlink()):
        project.local_env.mkdir()
    uid, gid = image_user()

    podman_quiet("rm", "-f", project.container)
    # Created up front rather than by `podman run`, to carry the labels
    for volume in project.volumes:
        if podman("volume", "exists", volume, check=False).returncode != 0:
            podman(
                "volume", "create", *project.label_args, volume,
                stdout=subprocess.DEVNULL,
            )  # fmt: skip

    run_args = [
        "-d",
        "--init",
        "--name", project.container,
        *project.label_args,
        f"--userns=keep-id:uid={uid},gid={gid}",
        "-e", f"HOME={CONTAINER_HOME}",
        "-e", f"DEVC_HISTORY_DIR={HISTORY_DIR}",
        *git_safe_directory_args([project.path, *(m.path for m in config.mounts)]),
        "-v", f"{project.path}:{project.path}:z",
        "-v", f"{project.local_env}:{project.local_env}:ro,z",
    ]  # fmt: skip
    # A file for worktrees and submodules, mounted the same way
    if project.git_dir.exists():
        run_args += ["-v", f"{project.git_dir}:{project.git_dir}:ro,z"]
    for dir_path, component in PERSISTED_DIRS.items():
        run_args += ["-v", f"{project.volume(component)}:{CONTAINER_HOME / dir_path}"]
    for mount in config.mounts:
        run_args += mount.podman_args()

    podman("run", *run_args, IMAGE, "sleep", "infinity", stdout=subprocess.DEVNULL)

    for file in COPIED_FILES:
        host_path = HOME / file
        if host_path.is_file():
            container_path = CONTAINER_HOME / file
            podman("exec", project.container, "mkdir", "-p", str(container_path.parent))
            podman(
                "cp",
                str(host_path),
                f"{project.container}:{container_path}",
                stdout=subprocess.DEVNULL,
            )


def git_safe_directory_args(paths: list[Path]) -> list[str]:
    """Let git trust the repos in and below the given paths, whatever their owner.

    Mounted files can appear owned by another user (e.g. through the podman machine
    on macOS), which git refuses as dubious ownership.
    """
    values = [value for path in paths for value in (str(path), f"{path}/*")]
    args = ["-e", f"GIT_CONFIG_COUNT={len(values)}"]
    for i, value in enumerate(values):
        args += [
            "-e", f"GIT_CONFIG_KEY_{i}=safe.directory",
            "-e", f"GIT_CONFIG_VALUE_{i}={value}",
        ]  # fmt: skip
    return args


def remove_container(project: Project) -> None:
    """Remove the project's container and persisted volumes."""
    podman_quiet("rm", "-f", project.container)
    for volume in project.volumes:
        podman_quiet("volume", "rm", "-f", volume)


class SessionCounter:
    """Counts the devc sessions attached to a container, so the last one to exit stops it."""

    def __init__(self, container: str) -> None:
        state_dir = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / "devc"
        state_dir.mkdir(parents=True, exist_ok=True)
        self._lock_file = state_dir / f"{container}.lock"
        self._count_file = state_dir / f"{container}.count"

    @contextmanager
    def locked(self) -> Iterator[None]:
        with self._lock_file.open("w") as f:
            fcntl.flock(f, fcntl.LOCK_EX)
            try:
                yield
            finally:
                fcntl.flock(f, fcntl.LOCK_UN)

    def get(self, default: int) -> int:
        try:
            return int(self._count_file.read_text().strip())
        except (OSError, ValueError):
            return default

    def set(self, count: int) -> None:
        self._count_file.write_text(f"{count}\n")

    def clear(self) -> None:
        self._count_file.unlink(missing_ok=True)


def _exit_on_signal(signum: int, _frame: FrameType | None) -> None:
    sys.exit(128 + signum)


@contextmanager
def session(project: Project, config: Config, reset: bool) -> Iterator[None]:
    """Start the container if needed and keep it running for the duration of the block."""
    sessions = SessionCounter(project.container)
    for sig in EXIT_SIGNALS:
        signal.signal(sig, _exit_on_signal)

    with sessions.locked():
        if reset:
            info("Resetting persisted volumes for this project...")
            remove_container(project)
            sessions.clear()
        if not is_running(project.container):
            start_container(project, config)
            sessions.set(0)
        # Defer exit signals until the try below, so the session is always released
        signal.pthread_sigmask(signal.SIG_BLOCK, EXIT_SIGNALS)
        sessions.set(sessions.get(0) + 1)

    try:
        signal.pthread_sigmask(signal.SIG_UNBLOCK, EXIT_SIGNALS)
        yield
    finally:
        for sig in EXIT_SIGNALS:
            signal.signal(sig, signal.SIG_IGN)
        with sessions.locked():
            remaining = sessions.get(1) - 1
            if remaining <= 0:
                info("Stopping container...")
                podman_quiet("rm", "-f", project.container)
                sessions.clear()
            else:
                sessions.set(remaining)


def exec_in_container(project: Project, workdir: Path, command: list[str]) -> int:
    # Ctrl-C is meant for the command inside the container. A no-op handler
    # rather than SIG_IGN, since ignored signals are inherited by podman
    signal.signal(signal.SIGINT, lambda *_: None)
    exec_args = [
        "--workdir", str(workdir),
        "--env", f"TERM={os.environ.get('TERM') or 'xterm'}",
        "--env", f"DEVC_SESSION_NAME={project.session_name}",
        "-it" if sys.stdin.isatty() and sys.stdout.isatty() else "-i",
    ]  # fmt: skip
    # Lets kitty's devc_window.py recognize devc windows and open another one like it
    env = {
        **os.environ,
        PROJECT_ENV: str(project.path),
        NAMESPACE_ENV: project.namespace,
        WORKDIR_ENV: str(workdir),
    }
    return podman(
        "exec", *exec_args, project.container, *command, check=False, env=env
    ).returncode


# --- project management ------------------------------------------------------


def list_projects() -> None:
    volumes = json.loads(
        podman_output(
            "volume", "ls", "--filter", f"label={PROJECT_LABEL}", "--format", "json"
        )
        or "[]"
    )
    projects = sorted(
        {
            Project(Path(v["Labels"][PROJECT_LABEL]), v["Labels"][NAMESPACE_LABEL])
            for v in volumes
        },
        key=lambda p: (str(p.path), p.namespace),
    )
    if not projects:
        info("No devc projects found")
        return

    rows = [("PROJECT", "NAMESPACE", "STATUS")]
    for project in projects:
        if is_running(project.container):
            count = SessionCounter(project.container).get(0)
            status = f"running ({count} session{'s' * (count != 1)})"
        else:
            status = "stopped"
        if not project.path.is_dir():
            status += ", directory missing"
        rows.append((str(project.path), project.namespace, status))
    widths = [max(len(row[i]) for row in rows) for i in range(2)]
    for path, namespace, status in rows:
        print(f"{path:<{widths[0]}}  {namespace:<{widths[1]}}  {status}")


def remove_project(project: Project) -> None:
    sessions = SessionCounter(project.container)
    with sessions.locked():
        if is_running(project.container):
            raise DevcError(f"{project} is running, exit its sessions first")
        existing = [
            volume
            for volume in project.volumes
            if podman("volume", "exists", volume, check=False).returncode == 0
        ]
        if not existing:
            raise DevcError(f"No devc project {project}")
        info(f"Removing {project}...")
        remove_container(project)
        sessions.clear()


# --- cli ---------------------------------------------------------------------

app = typer.Typer(add_completion=False, pretty_exceptions_enable=False)


def _check_namespace(value: str) -> str:
    if not NAMESPACE_PATTERN.fullmatch(value):
        raise typer.BadParameter(
            "must start with a letter or digit, followed by letters, digits, '_', '.' or '-'"
        )
    return value


def run(
    project: Project, workdir: Path, command: list[str], reset: bool, build: bool
) -> int:
    if not project.path.is_dir():
        raise DevcError(f"Project directory {project.path} does not exist")
    if contains_home(project.path):
        raise DevcError(
            f"Refusing to run in {project.path}: it contains your home directory"
        )
    config = project.load_config()
    project.check_workdir(workdir, config)

    ensure_podman_machine()
    ensure_image(build)

    with session(project, config, reset):
        return exec_in_container(project, workdir, command)


# Stop option parsing at the command, so its own flags are passed through
@app.command(
    context_settings={"allow_interspersed_args": False, "ignore_unknown_options": True}
)
def main(
    command: Annotated[
        list[str] | None,
        typer.Argument(help="Command to run inside the container.", show_default="zsh"),
    ] = None,
    project_dir: Annotated[
        Path | None,
        typer.Option(
            "--project",
            "-p",
            help="Project directory whose container to use. The command still runs"
            " in the current directory, which must be mounted.",
            show_default="current directory",
        ),
    ] = None,
    namespace: Annotated[
        str,
        typer.Option(
            "--namespace",
            "-n",
            help="Independent container and volumes for the same project.",
            callback=_check_namespace,
        ),
    ] = DEFAULT_NAMESPACE,
    reset: Annotated[
        bool,
        typer.Option("--reset", help="Delete the project's persisted volumes first."),
    ] = False,
    build: Annotated[
        bool, typer.Option("--build", help="Rebuild the image, even if it exists.")
    ] = False,
    list_: Annotated[
        bool, typer.Option("--list", help="List all projects and their namespaces.")
    ] = False,
    remove: Annotated[
        bool,
        typer.Option(
            "--rm", help="Delete the project's container and volumes in the namespace."
        ),
    ] = False,
) -> None:
    """Run a command (default: zsh) inside a per-project dev container."""
    returncode = 0
    try:
        if list_ and (remove or command or project_dir or reset or build):
            raise DevcError("--list can't be combined with other options or a command")
        if remove and (command or reset or build):
            raise DevcError("--rm can only be combined with --project and --namespace")

        workdir = logical_cwd()
        project_path = logical_path(project_dir, workdir) if project_dir else workdir
        project = Project(project_path, namespace)

        if list_:
            ensure_podman_machine()
            list_projects()
        elif remove:
            ensure_podman_machine()
            remove_project(project)
        else:
            returncode = run(project, workdir, command or ["zsh"], reset, build)
    except DevcError as e:
        info(str(e))
        raise typer.Exit(1) from e
    except subprocess.CalledProcessError as e:
        # podman already reported the error
        raise typer.Exit(e.returncode) from e
    raise typer.Exit(returncode)


if __name__ == "__main__":
    app()
