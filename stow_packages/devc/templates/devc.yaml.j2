default:
  mounts:
    - { path: ~/.cache, mode: persistent, name: cache }
    - { path: ~/.local/share/nvim, mode: persistent, name: nvim }
    - { path: ~/.local/state, mode: persistent, name: state }
namespaces:
  {%- if "claude" in MODULES_CONFIGURED.split() %}
  claude:
    {%- if OS == "fedora" %}
    krun: true
    {%- endif %}
    mounts:
      - { path: ~/.local/state, mode: persistent, name: state }
      - { path: ~/.claude, mode: persistent, name: claude }
    env:
      CLAUDE_CONFIG_DIR: /home/dev/.claude
    dockerfile: |
      RUN MODULES="claude" ~/dotfiles/setup.sh
  {%- endif %}
